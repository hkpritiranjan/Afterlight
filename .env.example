# ============================================================
# Game Server
# ============================================================
GAME_SERVER_PORT=3001

# Allowed origin for Socket.IO CORS
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=afterlight
POSTGRES_USER=afterlight
POSTGRES_PASSWORD=afterlight_dev

# Full connection string (used by the game server and migration tools)
DATABASE_URL=postgresql://afterlight:afterlight_dev@localhost:5433/afterlight

# ============================================================
# Web App (Next.js)
# NEXT_PUBLIC_ prefix makes these available in the browser
# ============================================================
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:3001
